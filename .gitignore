__pycache__/
*.pyc
# Recordings made with the app (the default folder) - large, and not code.
recordings/
# Finder's folder settings, on a Mac.
.DS_Store
# Claude Code's local settings for this checkout, and the link that lets Claude Code
# load the project skill, which is kept in .agents/skills/ (Claude Code reads only
# .claude/skills/). Make the link in each checkout:
#   mkdir -p .claude/skills && ln -s ../../.agents/skills/fm-receiver .claude/skills/fm-receiver
.claude/
# RF CTF challenge work: IQ recordings (tens of GB), scripts and write-ups.
challenge/
# Web summaries of signal work (pages and pictures), kept out of the public repo.
web_summary/
# IQ and other captured data anywhere in the checkout, not only in recordings/: the
# repo is public, and a capture holds what was on air (cell IDs, payloads).
# Tests write theirs to temporary folders.
*.cfile
*.cf32
*.sigmf-data
*.sigmf-meta
*.sdvr
*.cdif
*.fft
*.card.json
*-recording.json
