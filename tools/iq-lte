#!/usr/bin/env python3
"""iq-lte: structural fingerprint of an LTE block, and optionally its broadcast SI.

    tools/iq-lte FILE [--block-center HZ] [--t0 S --t1 S] [--rate R --center HZ]
    tools/iq-lte FILE --decode [--ports N ...]
    tools/iq-lte FILE --mib [--pdcch | --pdsch]
    tools/iq-lte FILE --own

The block is mixed to 0 Hz and read with ``iqmeasure.extract`` (band-limited,
in chunks). Stdout is one JSON document: the fingerprint (verdict, PSS root,
PCI, frame timing, bandwidth class) and, with ``--decode``, the MIB and the
SIB1 from an outside ``pdsch_ue`` (``$FMRX_LTE_TOOLS/run_pdsch.sh``). With
``--mib`` each FDD cell gains ``own_mib``: its MIB from our own PBCH decoder
(``iqlte_phy.pbch``, numpy only, roadmap Round 29.1); ``--pdcch`` adds
``own_pdcch``, its SIB1 DCIs (``iqlte_phy.sib1_dcis``, Round 29.2), and
``--pdsch`` both and ``own_sib1``, SIB1 itself (``iqlte_phy.sib1``, Round 29.3:
its bytes, and its fields when pycrate is under ``$FMRX_LTE_TOOLS``). ``--own``
reads all of it and the SI messages SIB1 schedules (``iqlte_phy.si_messages``,
Round 29.6; pycrate reads the schedule and the SIBs), each cell gaining ``own``,
shaped as ``--decode``'s ``decode`` (the card's ``own`` the strongest cell's), and
``own_si``, the blocks; its span defaults to ``DEFAULT_SI_S``. Only the
broadcast channel is decoded. Numpy only; the outside tools are subprocesses.

Exit 0 when the run completed, whatever the verdict. Exit 1 for a bad option,
a file that cannot be read, or a sweep file. Exit 2 when ``--decode`` needs a
program that is not under ``$FMRX_LTE_TOOLS``.
"""

import argparse
import json
import math
import os
import sys

import numpy as np

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from fm_receiver import iqmeasure, iqlte, iqlte_decode, iqlte_phy  # noqa: E402

# Default look, and the longest look. A longer request is cut to the cap. Our own
# decoders (--mib, --pdcch, --pdsch) read the whole span from the file as they go
# (iqmeasure.IQView), so it costs no memory; the fingerprint, which holds what it
# reads several times over (about 1.9 GB a second at 20 MS/s), looks at its first
# FINGERPRINT_S only.
DEFAULT_SPAN_S = 0.2
MAX_SPAN_S = 10.0
FINGERPRINT_S = 1.0
# What --decode reads from t0: SIB24 repeats every 512 frames (5.12 s), so 6 s
# holds one of every SI message; a longer request is cut to the cap.
DEFAULT_SI_S = 6.0
MAX_SI_S = 10.0
_DEFAULT_PORTS = (4, 2, 1)


def _refuse(message):
    """A bad option or a file this cannot read: stderr, nothing on stdout, exit 1."""
    sys.stderr.write('iq-lte: %s\n' % message)
    return 1


def _missing(name):
    """The outside tools directory or a program in it is absent. Exit 2."""
    tools = iqlte_decode.tools_dir()
    sys.stderr.write('iq-lte: %s is missing under FMRX_LTE_TOOLS (%s). '
                     'srsRAN 4G is built separately and is not part of this repo; '
                     'run_pdsch.sh, pdsch_ue and pyc/bin/python live in that directory.\n'
                     % (name, tools))
    return 2


def _own_sib1(iq, rate, cell, block_hz, known=None):
    """``own_sib1`` of a cell: our own SIB1 decode (``iqlte_phy.sib1``, ``known`` cells taken
    out), and the fields pycrate reads from its bytes; with the decode itself, which
    ``iqlte_phy.known_cell`` takes, as the second value."""
    got = iqlte_phy.sib1(iq, rate, cell, cell['own_mib'], cell.get('own_pdcch'), carrier_hz=block_hz,
                         known=known)
    if got is None:
        return None, None
    full = dict(got)
    got = dict(got)
    got.pop('dcis', None)
    got['fields'], got['fields_reason'] = None, None
    if got['sib1']:
        got['fields'], got['fields_reason'] = iqlte_decode.parse_sib1(bytes.fromhex(got['sib1']),
                                                                      iqlte_decode.tools_dir())
    return got, full


def _dump(records):
    """``[(subframe, hex)]`` as the outside decoder's dump (``iqlte_decode.dump_payloads``)."""
    out = bytearray()
    for sub, hx in records:
        data = bytes.fromhex(hx)
        out += bytes((iqlte_decode._DUMP_MARK, int(sub) & 0xFF, len(data) & 0xFF, len(data) >> 8)) + data
    return bytes(out)


def _own_si(iq, rate, cell, block_hz, known=None):
    """``(own, own_si)`` of a cell (``--own``, roadmap Round 29.6): ``own`` shaped as ``--decode``'s
    ``decode`` (``ran``, ``mib``, ``sib1``, ``si``, a ``*_reason`` beside each that is None) from our
    own decoders, ``own_si`` the SI blocks (``iqlte_phy.si_messages``) or None.

    pycrate reads SIB1's schedule from our SIB1 (``iqlte_decode.read_si``), the SI messages are
    read in their windows with ``known`` taken out, and every block that passed (SIB1's copies
    and sums, then the SI's) goes to ``read_si`` as the outside decoder's dump would."""
    mib, s1 = cell.get('own_mib') or {}, cell.get('own_sib1') or {}
    out = {'ran': True, 'mib': None, 'sib1': None, 'si': None}
    if not mib.get('mib'):
        out.update(reason='MIB not decoded', sib1_reason='MIB not decoded', si_reason='MIB not decoded')
        return out, None
    m = mib['mib']
    out['mib'] = {'pci': int(cell['pci']), 'ports': int(mib['ports']), 'prb': int(m['n_rb']), 'type': 'FDD',
                  'cp': 'Normal', 'sfn': int(m['sfn'])}
    records = [(5, b['hex']) for b in s1.get('blocks', []) if b.get('hex')]
    records += [(5, c['hex']) for c in s1.get('combined', [])]
    if not records:
        out['sib1_reason'] = out['si_reason'] = 'SIB1 not decoded'
        return out, None
    out['sib1'] = s1.get('fields')
    if out['sib1'] is None:
        out['sib1_reason'] = s1.get('fields_reason')
    tools, frames = iqlte_decode.tools_dir(), int(mib.get('frames') or 0)
    first, why = iqlte_decode.read_si(_dump(records), tools, frames)
    if first is None or not first.get('schedule'):
        out['si'], out['si_reason'] = first, why or 'SIB1 schedules no SI message'
        return out, None
    got = iqlte_phy.si_messages(iq, rate, cell, mib, first['schedule'], first.get('window_ms'),
                                carrier_hz=block_hz, known=known)
    records += [(b['subframe'], b['hex']) for b in (got or {}).get('blocks', []) if b.get('hex')]
    records += [(c['subframes'][0] % 10, c['hex']) for c in (got or {}).get('combined', [])]
    si, why = iqlte_decode.read_si(_dump(records), tools, frames)
    if si and si.get('note'):
        si['note'] = 'no SI message besides SIB1 was decoded in the windows SIB1 schedules'
    out['si'] = si
    if si is None:
        out['si_reason'] = why
    return out, got


def _own_cells(iq, rate, cells, block_hz, pdcch, pdsch, si=False):
    """Our own decode of each FDD cell (``own_mib``, ``own_pdcch``, ``own_sib1``) over ``iq`` (the
    whole span, an ``iqmeasure.IQView``), strongest first,
    each with the cells decoded before it taken out (roadmap Round 29.5: sectors of one site send
    their broadcast on the same REs; a cell of another site is taken out of the samples), a cell
    left short (no MIB, a DCI or SIB1 copy missed alone) read once more with the others known; ``own_known`` lists the PCIs taken
    out. With ``si``, each cell's SI messages too, the same cells taken out, their SI included
    (``_own_si``, ``iqlte_phy.known_si``)."""
    def read(cell, use):
        cell['own_known'] = [k['pci'] for k in use]
        cell['own_mib'] = iqlte_phy.pbch(iq, rate, cell, carrier_hz=block_hz, known=use or None)
        if pdcch or pdsch:
            cell['own_pdcch'] = iqlte_phy.sib1_dcis(iq, rate, cell, cell['own_mib'], carrier_hz=block_hz,
                                                    known=use or None)
        full = None
        if pdsch:
            cell['own_sib1'], full = _own_sib1(iq, rate, cell, block_hz, use or None)
        return iqlte_phy.known_cell(rate, cell, cell['own_mib'], cell.get('own_pdcch'), full,
                                    carrier_hz=block_hz)

    def short(cell):
        mib, dcis, s1 = cell['own_mib'], cell.get('own_pdcch') or {}, cell.get('own_sib1') or {}
        return (not mib.get('mib') or ((pdcch or pdsch) and len(dcis.get('dcis', [])) < (dcis.get('subframes') or 0))
                or (pdsch and (s1.get('decoded') or 0) < (s1.get('tried') or 0)))

    def score(cell):
        mib, dcis, s1 = cell['own_mib'], cell.get('own_pdcch') or {}, cell.get('own_sib1') or {}
        return (bool(s1.get('sib1')), bool(mib.get('mib')), s1.get('decoded') or 0, len(dcis.get('dcis', [])),
                mib.get('decoded') or 0)

    keys = ('own_known', 'own_mib', 'own_pdcch', 'own_sib1')

    known, order = [], []
    for cell in cells:
        if not isinstance(cell, dict) or cell.get('duplex', 'FDD') != 'FDD':
            continue
        kc = read(cell, list(known))
        order.append((cell, kc))
        if kc is not None:
            known.append(kc)
    # A cell of another site as strong as a sector may come before it: a cell left short (no MIB, a
    # SIB1 DCI or a SIB1 copy missed alone) is read once more with every other cell known, those decoded after it too (cells
    # of one timing are fitted together); the second read is kept unless it is worse.
    for cell, kc in order:
        others = [k for k in known if k is not kc]
        if not short(cell) or len(others) <= len(cell['own_known']):
            continue
        before = {k: cell[k] for k in keys if k in cell}
        new = read(cell, others)
        if score(cell) < score(before):
            for k in keys:
                cell.pop(k, None)
            cell.update(before)
        else:
            if kc is not None:
                known.remove(kc)
            if new is not None:
                known.append(new)
    if si:
        by_pci = {k['pci']: k for k in known}
        for cell, _kc in order:
            use = [by_pci[p] for p in cell['own_known'] if p in by_pci]
            cell['own'], cell['own_si'] = _own_si(iq, rate, cell, block_hz, use or None)
            # Strongest first: a weaker cell's SI is read with this one's taken out (roadmap 29.7).
            iqlte_phy.known_si(by_pci.get(cell['pci']), cell['own_si'])


def _check_options(args):
    for name, value in (('--t0', args.t0), ('--t1', args.t1),
                        ('--center', args.center), ('--block-center', args.block_center)):
        if value is not None and not math.isfinite(value):
            return _refuse('%s must be a finite number.' % name)
    if args.si_seconds is not None and (not math.isfinite(args.si_seconds) or args.si_seconds <= 0):
        return _refuse('--si-seconds must be a positive number.')
    if args.t0 is not None and args.t1 is not None and args.t0 >= args.t1:
        return _refuse('--t0 (%g s) is not before --t1 (%g s).' % (args.t0, args.t1))
    if args.rate is not None and (not math.isfinite(args.rate) or args.rate <= 0):
        return _refuse('--rate must be a finite sample rate above 0.')
    if args.ports is not None:
        if not args.ports:
            return _refuse('--ports needs at least one port count.')
        for count in args.ports:
            if count < 1:
                return _refuse('--ports must be port counts of 1 or more.')
    return None


def _json_num(value):
    """A JSON number, an integer when ``value`` is one, so a centre in Hz compares equal."""
    if value is None:
        return None
    if isinstance(value, (bool, np.bool_)):
        return bool(value)
    if isinstance(value, (int, np.integer)):
        return int(value)
    x = float(value)
    if not math.isfinite(x):
        return None
    rounded = round(x)
    if abs(x - rounded) <= 1e-6 * max(1.0, abs(rounded)):
        return int(rounded)
    return x


def _span(args):
    """``(t0, t1)`` in seconds. The default is 0.2 s from ``t0`` (``DEFAULT_SI_S`` with ``--own``, for
    the SI messages that repeat slowly); longer than ``MAX_SPAN_S`` is cut."""
    t0 = 0.0 if args.t0 is None else float(args.t0)
    if args.t1 is None:
        t1 = t0 + (DEFAULT_SI_S if args.own else DEFAULT_SPAN_S)
    else:
        t1 = float(args.t1)
    if t1 - t0 > MAX_SPAN_S:
        t1 = t0 + MAX_SPAN_S
    return t0, t1


def _fingerprint(iq, fs):
    """``fingerprint`` plus the SSS frame fields it already computed.

    ``sss_search`` is the slow part and ``fingerprint`` calls it once. The
    wrapper keeps that result (half-frame and frame offset) instead of
    running the search a second time.
    """
    saved = {}
    real = iqlte.sss_search

    def wrapped(block, rate):
        found = real(block, rate)
        saved['sss'] = found
        return found

    iqlte.sss_search = wrapped
    try:
        card = iqlte.fingerprint(iq, fs)
    finally:
        iqlte.sss_search = real
    return card, saved.get('sss')


def _cells_of(fp):
    """The cell list ``fingerprint`` already computed on this block.

    ``fingerprint`` calls ``iqlte.cells`` once and keeps the list. A second
    call would search the same block again. Entries are copied so a later
    ``decode`` key is not written back into the fingerprint.
    """
    found = fp.get('cells')
    if not isinstance(found, list):
        return []
    out = []
    for cell in found:
        out.append(dict(cell) if isinstance(cell, dict) else cell)
    return out


def _card(path, block_hz, sl, fp, sss, decode, cells, seconds):
    nfft = fp.get('nfft')
    nfft = None if nfft is None else int(nfft)
    pci = fp.get('pci')
    pci = None if pci is None else int(pci)
    nid2 = fp.get('nid2')
    nid2 = None if nid2 is None else int(nid2)
    nid1 = None
    half = None
    offset = None
    if isinstance(sss, dict):
        if sss.get('nid1') is not None:
            nid1 = int(sss['nid1'])
        if sss.get('half_frame') is not None:
            half = int(sss['half_frame'])
        if sss.get('frame_offset_samples') is not None:
            offset = int(sss['frame_offset_samples'])
    duplex = fp.get('duplex')
    if duplex == 'TDD' and cells and isinstance(cells[0], dict):
        # The TDD cell came from cells(): its own timing and IDs.
        offset = cells[0].get('frame_offset_samples')
        half = cells[0].get('half_frame')
        nid1 = nid2 = None
    if nid1 is None and pci is not None:
        nid1 = pci // 3
    if nid2 is None and pci is not None:
        nid2 = pci % 3
    bw = iqlte.BANDWIDTH_MHZ.get(nfft)
    return {
        'file': path,
        'block_center_hz': _json_num(block_hz),
        'rate_sps': _json_num(sl.rate),
        'duration_s': _json_num(seconds),
        'fingerprint_s': _json_num(sl.t1 - sl.t0),
        'verdict': fp.get('verdict'),
        'nid2': nid2,
        'nid1': nid1,
        'pci': pci,
        'nfft': nfft,
        'bandwidth_mhz': bw if isinstance(bw, float) else _json_num(bw) if bw is not None else None,
        'half_frame': half,
        'frame_offset_samples': offset,
        'duplex': duplex,
        'checks': fp.get('checks'),
        'cells': cells,
        'decode': decode,
    }


def _skip_decode(fp, pci):
    """Why this PCI is not given to ``pdsch_ue``, or None when it should be.

    Every cell is gated on the capture-level fingerprint verdict (and on
    that fingerprint's FFT size), not on a per-cell verdict. A cell list
    on a capture whose verdict is ``not-lte`` or ``unknown``, or that is not
    10 or 15 MHz, is not decoded. ``possible`` is decoded: a real carrier
    read ``possible`` while both decoders read its MIB (2026-10-25).
    """
    verdict = fp.get('verdict')
    if fp.get('duplex') == 'TDD':
        return {'ran': False, 'reason': 'TDD: the srsRAN wrapper decodes FDD only'}
    if verdict not in ('lte', 'possible') or pci is None:
        why = 'verdict is %s' % verdict
        if pci is None:
            why = 'no PCI (verdict %s)' % verdict
        return {'ran': False, 'reason': why}
    nfft = fp.get('nfft')
    if nfft not in iqlte_decode.SUPPORTED_NFFT:
        return {
            'ran': False,
            'reason': 'only 10 and 15 MHz carriers are decoded (nfft %s)' % nfft,
        }
    return None


def _frame_of(cell):
    """``(frame_offset_samples, half_frame)`` for one cell, either of them None."""
    offset = cell.get('frame_offset_samples')
    half = cell.get('half_frame')
    if offset is not None:
        offset = int(offset)
    if half is not None:
        half = int(half)
    return offset, half


def _decode_source(args, src, sl, block_hz, t0):
    """``(iq, rate)`` for ``--decode``: ``--si-seconds`` from ``t0``, centred like ``sl``.

    It starts at the same ``t0`` as the fingerprint, so a frame offset found there
    holds here. When it is no longer than ``sl``, ``sl`` itself is used. A longer
    span is a ``SampleSource``: read and mixed piece by piece when the decoder
    resamples it, never held whole (a few seconds at 20 MS/s is gigabytes once
    resampled at once).
    """
    seconds = DEFAULT_SI_S if args.si_seconds is None else float(args.si_seconds)
    seconds = min(seconds, MAX_SI_S)
    rate = float(src.rate)
    i_start = int(round(t0 * rate))
    n = min(int(round(seconds * rate)), int(src.samples) - i_start)
    if n <= sl.iq.size:
        return sl.iq, sl.rate
    delta_hz = block_hz - float(src.center_hz)

    def read(i0, i1):
        # extract at the file rate is a plain slice: pieces join without a seam.
        part = iqmeasure.extract(
            args.file, t0=(i_start + i0) / rate, t1=(i_start + i1) / rate, band=None,
            max_rate=rate, rate=args.rate, center_hz=args.center).iq
        if abs(delta_hz) >= 1e-3:
            t = np.arange(i0, i0 + part.size) / rate
            part = part * np.exp(-2j * np.pi * delta_hz * t)
        return part

    return iqlte_decode.SampleSource(n, rate, read), rate


def _decode(args, data, fp, sss, cells):
    """The top-level ``decode``, or an exit code (2) when the tools are missing.

    Each cell dict that has a PCI gains its own ``decode``, read at that
    cell's frame offset. The top-level object stays the strongest cell's,
    which is the first entry. With no such cell, it is the single-cell
    decode of the fingerprint PCI, as before.
    """
    ports = tuple(args.ports) if args.ports else _DEFAULT_PORTS
    runnable = []
    for cell in cells:
        if not isinstance(cell, dict) or cell.get('pci') is None:
            continue
        blocked = _skip_decode(fp, cell.get('pci'))
        if blocked is not None:
            cell['decode'] = blocked
            continue
        offset, half = _frame_of(cell)
        runnable.append((cell, int(cell['pci']), offset, half))
    if runnable:
        try:
            specs = [(pci, offset, half) for _cell, pci, offset, half in runnable]
            decoded = iqlte_decode.decode_cells(data[0], data[1], specs, ports, nfft=fp.get('nfft'))
        except iqlte_decode.ToolsMissing as exc:
            return _missing(exc.name)
        for (cell, _pci, _offset, _half), result in zip(runnable, decoded):
            cell['decode'] = result
    if cells and isinstance(cells[0], dict) and isinstance(cells[0].get('decode'), dict):
        return cells[0]['decode']
    blocked = _skip_decode(fp, fp.get('pci'))
    if blocked is not None:
        return blocked
    offset = None
    if isinstance(sss, dict) and sss.get('frame_offset_samples') is not None:
        offset = int(sss['frame_offset_samples'])
    try:
        return iqlte_decode.decode_cell(data[0], data[1], int(fp['pci']), offset, ports, nfft=fp.get('nfft'))
    except iqlte_decode.ToolsMissing as exc:
        return _missing(exc.name)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('file', help='the recording (.cfile, .sdvr or .cdif)')
    ap.add_argument('--block-center', type=float, metavar='HZ',
                    help='Hz of the LTE carrier (default: the file centre)')
    ap.add_argument('--t0', type=float, metavar='S', help='start of the span, seconds (default 0)')
    ap.add_argument('--t1', type=float, metavar='S',
                    help='end of the span, seconds (default t0+0.2; at most 10 s; the fingerprint reads its first 1 s)')
    ap.add_argument('--rate', type=float, metavar='R',
                    help='samples/s, for a .cfile with no .sigmf-meta')
    ap.add_argument('--center', type=float, metavar='HZ',
                    help='centre frequency in Hz, for a bare .cfile')
    ap.add_argument('--decode', action='store_true',
                    help='read the MIB and SIB1 of each cell with '
                         '$FMRX_LTE_TOOLS/run_pdsch.sh, strongest cell first. '
                         'A cell offset is only known modulo a 5 ms half-frame '
                         '(cells report half_frame 0), so both boundaries are tried')
    ap.add_argument('--mib', action='store_true',
                    help="decode each cell's MIB with our own numpy PBCH decoder (iqlte_phy, "
                         "roadmap 29.1): no outside program; each cell gains own_mib")
    ap.add_argument('--pdcch', action='store_true',
                    help="with --mib's MIB, decode each cell's SIB1 DCIs (PCFICH and PDCCH, "
                         "SI-RNTI) with our own decoder (roadmap 29.2): each cell gains own_pdcch")
    ap.add_argument('--pdsch', action='store_true',
                    help="with --pdcch's DCIs, decode each cell's SIB1 (PDSCH, turbo DL-SCH) with "
                         "our own decoder (roadmap 29.3): each cell gains own_sib1 (pycrate, if "
                         "present, parses it)")
    ap.add_argument('--own', action='store_true',
                    help="read each cell's broadcast with our own decoders: --pdsch, then the SI "
                         "messages SIB1 schedules (roadmap 29.6); each cell gains own, shaped as "
                         "--decode's decode, and own_si; pycrate under $FMRX_LTE_TOOLS reads the "
                         "schedule and the SIBs. The span defaults to %g s" % DEFAULT_SI_S)
    ap.add_argument('--ports', type=int, nargs='+', metavar='N',
                    help='antenna port counts to try, in order (default: 4 2 1)')
    ap.add_argument('--si-seconds', type=float, metavar='S',
                    help='seconds from t0 that --decode reads, for the SIBs that repeat '
                         'slowly (default %g, at most %g; the fingerprint keeps its own span)'
                         % (DEFAULT_SI_S, MAX_SI_S))
    try:
        args = ap.parse_args(argv)
    except SystemExit as exc:
        code = exc.code
        if code is None or code == 0:
            return 0
        return 1
    refused = _check_options(args)
    if refused:
        return refused

    t0, t1 = _span(args)
    try:
        src = iqmeasure.open_iq(args.file, rate=args.rate, center_hz=args.center)
        block_hz = src.center_hz if args.block_center is None else float(args.block_center)
        # max_rate at the file rate: extract reads the span in chunks and does
        # not decimate. The mix below is what centres the block. The fingerprint
        # holds its span: only the first FINGERPRINT_S of it.
        sl = iqmeasure.extract(
            args.file, t0=t0, t1=min(t1, t0 + FINGERPRINT_S), band=None,
            max_rate=float(src.rate),
            rate=args.rate, center_hz=args.center)
        sl = sl._replace(iq=iqlte.mix_to_dc(sl.iq, sl.rate, block_hz - float(src.center_hz)))
        # Our own decoders read the whole span, from the file as they go, mixed alike.
        i0 = int(round(sl.t0 * float(src.rate)))
        span = src.view(i0, min(int(src.samples), int(round(t1 * float(src.rate)))),
                        block_hz - float(src.center_hz))
    except iqmeasure.IQSourceError as exc:
        return _refuse(exc)
    except OSError as exc:
        return _refuse(exc)

    fp, sss = _fingerprint(sl.iq, sl.rate)
    cells = _cells_of(fp)
    if args.mib or args.pdcch or args.pdsch or args.own:
        _own_cells(span, sl.rate, cells, block_hz, args.pdcch or args.own, args.pdsch or args.own, args.own)
    decode = None
    if args.decode:
        try:
            decode = _decode(args, _decode_source(args, src, sl, block_hz, t0), fp, sss, cells)
        except (iqmeasure.IQSourceError, OSError) as exc:
            return _refuse(exc)
        if isinstance(decode, int):
            return decode
    card = _card(args.file, block_hz, sl, fp, sss, decode, cells, len(span) / float(src.rate))
    if args.own:
        own = [c for c in cells if isinstance(c, dict) and 'own' in c]
        card['own'] = own[0]['own'] if own else {'ran': False, 'reason': 'no FDD cell to read'}
    json.dump(card, sys.stdout, indent=2, allow_nan=False)
    sys.stdout.write('\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
