#!/usr/bin/env python3
"""iq-picture: a spectrum (mean and peak) over a waterfall of an IQ recording.

    tools/iq-picture FILE OUT.png [--t0 S --t1 S] [--band LO HI]
                                  [--rate R --center HZ] [--nfft N] [--cells]

The span is the whole file, or ``--t0``/``--t1`` in seconds, and at most the
first 30 s when ``--t1`` is left out. ``--band`` is absolute Hz. Levels are
dBm when the file carries a calibration, otherwise dBFS. The file is read a
chunk at a time; the waterfall is binned to a few hundred rows before it is
drawn, so a long recording is never held whole.

``--cells`` draws where the LTE cells' and 5G NR cells' sync signals sit, as
the measurement card finds them in 50 ms from ``--t0``
(``iqmeasure.cells_file``): a box over each LTE cell's PSS and SSS (72
subcarriers, every 5 ms) and over each NR cell's sync block (240 subcarriers,
4 symbols, every burst period), labelled with the PCI. The span is then 20 ms
by default, and the FFT 256 long, so a row of the waterfall is shorter than an
OFDM symbol (about 71 us at 15 kHz); 30 s and 4096 would hide them.

``peak_panel`` returns the frequency axis and the peak-hold trace the top
panel plots, and ``cell_boxes`` the boxes ``--cells`` draws. Importing this
file does not draw anything.
"""

import argparse
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from fm_receiver import iqmeasure  # noqa: E402

import numpy as np

#: Seconds taken when the end of the span is left open (the measurement card's rule).
MAX_SPAN_S = 30.0
#: Samples read at a time. A span is never held whole.
CHUNK = 1 << 18
#: Default FFT length. A bin is then rate / 4096.
DEFAULT_NFFT = 4096
#: Shorter than this, the Hann window is all zeros and every level is NaN.
MIN_NFFT = 8
#: Longer than this, one FFT is gigabytes. 2**20 complex samples is 8 MB.
MAX_NFFT = 1 << 20
#: The waterfall is reduced to this before it is drawn.
MAX_ROWS = 400
MAX_COLS = 2000
#: With --cells: the span left open, and the FFT length when none is asked for.
CELLS_SPAN_S = 0.02
CELLS_NFFT = 256
#: LTE (36.211 6.11, normal prefix): the PSS and SSS take the 72 subcarriers around the
#: centre; FDD puts the SSS and PSS in the last two symbols of slots 0 and 10, TDD the SSS
#: in the last symbol of slot 1 and the PSS in the third of subframe 1 (and 5 ms later).
#: Times from the frame's start, in units of 1/30.72 MHz.
LTE_TS = 1 / 30.72e6
LTE_SYNC_HALF_HZ = 36 * 15e3
LTE_SYNC_TIMES = {'FDD': [(10976, 15360)], 'TDD': [(28528, 30720), (30720 + 4400, 30720 + 6592)]}
LTE_HALF_FRAME_S = 5e-3
#: NR (38.211 7.4.3.1): an SSB is 240 subcarriers by 4 symbols, SS_REF at subcarrier 120.
NR_SSB_SYMBOL_TS = 2048 + 144


def _fail(message):
    raise iqmeasure.IQSourceError(message)


def _finite(name, value):
    """``value`` as a finite float, or an error that says which argument it was."""
    try:
        number = float(value)
    except (TypeError, ValueError) as exc:
        _fail(f"{name} must be a finite number.")
        raise exc
    if not math.isfinite(number):
        _fail(f"{name} must be a finite number.")
    return number


def _nfft_of(n, nfft):
    """FFT length that fits ``n`` samples: the one asked for, or fewer when the span is shorter.

    The length asked for has to be at least 8 and at most 2**20. A shorter span
    uses fewer bins, but never so few that the Hann window vanishes.
    """
    nfft = int(DEFAULT_NFFT if nfft is None else nfft)
    if nfft < MIN_NFFT:
        _fail(f"nfft must be at least {MIN_NFFT}.")
    if nfft > MAX_NFFT:
        _fail(f"nfft must be at most {MAX_NFFT}.")
    if n < MIN_NFFT:
        _fail(f"the span holds {n} samples, fewer than one FFT of {MIN_NFFT}.")
    return min(nfft, n)


def _indexes(src, t0, t1):
    """Sample range of the span: ``t0`` to ``t1`` seconds, clipped to the file.

    With ``t1`` omitted the span stops at 30 s, as ``iqmeasure.measure_file`` does.
    A non-finite edge, or a start that is not before the end, is refused.
    """
    start_s = 0.0 if t0 is None else _finite("--t0", t0)
    if t1 is None:
        stop_s = min(src.seconds, start_s + MAX_SPAN_S)
    else:
        stop_s = _finite("--t1", t1)
    if t0 is not None and t1 is not None and not start_s < stop_s:
        _fail(f"the span {start_s:g} to {stop_s:g} s is empty: t0 must be before t1.")
    try:
        i0 = max(0, int(round(start_s * src.rate)))
        i1 = min(src.samples, int(round(stop_s * src.rate)))
    except (ValueError, OverflowError):
        _fail(f"{os.path.basename(src.path)}: the span {start_s:g} to {stop_s:g} s is not usable.")
    if i1 - i0 < 1:
        _fail(f"{os.path.basename(src.path)}: the span {start_s:g} to {stop_s:g} s is empty.")
    return i0, i1


def _open(path, rate, center_hz):
    """``open_iq``, after refusing a rate that is not a finite number above zero."""
    if rate is not None:
        rate = _finite("--rate", rate)
        if rate <= 0:
            _fail("the sample rate must be a finite number above zero.")
    return iqmeasure.open_iq(path, rate=rate, center_hz=center_hz)


def _column_edges(n, limit):
    """Starts of at most ``limit`` slices covering ``n`` bins, or None to keep them all."""
    if n <= limit:
        return None
    edges = np.unique(np.linspace(0, n, limit + 1).astype(np.int64))
    if edges[-1] != n:
        edges = np.concatenate([edges, np.array([n], dtype=np.int64)])
    return edges


def _reduce_rows(power, rows):
    """Peak of each run of ``power`` rows that share a waterfall row. ``rows`` is monotonic."""
    if len(rows) == 1:
        return rows, power
    cuts = np.flatnonzero(np.diff(rows)) + 1
    starts = np.empty(cuts.size + 1, dtype=np.int64)
    starts[0] = 0
    starts[1:] = cuts
    return rows[starts], np.maximum.reduceat(power, starts, axis=0)


def spectra(src, i0, i1, nfft, band):
    """Mean and peak spectra, and a binned waterfall, of samples ``i0:i1``.

    Each block is ``nfft`` samples under a Hann window. The mean is the
    averaged power and the peak is the max power, both per bin, calibrated
    so that a tone reads its own power (a full-scale tone is 0 dBFS). The waterfall keeps
    the peak of the blocks and bins that fall in each cell, at most
    ``MAX_ROWS`` by ``MAX_COLS``.
    """
    n = i1 - i0
    nfft = _nfft_of(n, nfft)
    n_blocks = n // nfft
    if n_blocks < 1:
        _fail(f"{os.path.basename(src.path)}: the span holds {n} samples, fewer than one FFT.")

    window = np.hanning(nfft).astype(np.float32)
    # Tone-calibrated, as sweep.py is: a tone on a bin reads its own power.
    norm = float(np.sum(window.astype(np.float64))) ** 2
    freq = np.fft.fftshift(np.fft.fftfreq(nfft, 1.0 / src.rate)) + src.center_hz
    if band is None:
        keep = np.arange(nfft)
    else:
        lo, hi = _finite("--band LO", band[0]), _finite("--band HI", band[1])
        if lo > hi:
            _fail(f"the band {lo:g} to {hi:g} Hz has its low edge above its high edge.")
        keep = np.flatnonzero((freq >= lo) & (freq <= hi))
        if keep.size == 0:
            _fail("the band covers no frequency bins.")
    edges = _column_edges(keep.size, MAX_COLS)
    n_cols = keep.size if edges is None else len(edges) - 1
    n_rows = min(MAX_ROWS, n_blocks)

    sum_p = np.zeros(nfft, dtype=np.float64)
    peak = np.zeros(nfft, dtype=np.float64)
    waterfall = np.zeros((n_rows, n_cols), dtype=np.float64)

    # One working buffer: a small FFT is stacked up to CHUNK samples, a large
    # one is a single block. Nothing grows with the file, and nothing past nfft.
    room = CHUNK if nfft <= CHUNK else nfft
    buf = np.empty(room, dtype=np.complex64)
    filled = 0
    got = 0
    block = 0
    want = n_blocks * nfft
    while got < want and block < n_blocks:
        take = min(room - filled, want - got)
        piece = src.read(i0 + got, take)
        if piece.size == 0:
            break
        nread = int(piece.size)
        buf[filled:filled + nread] = piece
        filled += nread
        got += nread
        use = min(filled // nfft, n_blocks - block)
        if use == 0:
            continue
        taken = use * nfft
        frame = np.fft.fft(buf[:taken].reshape(use, nfft) * window, axis=1)
        power = np.fft.fftshift(frame.real.astype(np.float64) ** 2
                                + frame.imag.astype(np.float64) ** 2, axes=1)
        sum_p += power.sum(axis=0)
        peak = np.maximum(peak, power.max(axis=0))

        shown = power[:, keep]
        if edges is not None:
            shown = np.maximum.reduceat(shown, edges[:-1], axis=1)
        rows = (np.arange(block, block + use) * n_rows) // n_blocks
        which, reduced = _reduce_rows(shown, rows)
        waterfall[which] = np.maximum(waterfall[which], reduced)

        tail = filled - taken
        if tail:
            buf[:tail] = buf[taken:filled]
        filled = tail
        block += use

    scale = n_blocks * norm
    mean = sum_p / scale
    peak = peak / norm
    waterfall = waterfall / norm
    return freq[keep], mean[keep], peak[keep], waterfall


def _db(power, full_scale_dbm):
    """Power as dBFS, or dBm when the source names a full-scale level."""
    db = 10.0 * np.log10(np.maximum(power, 1e-30))
    if full_scale_dbm is None:
        return db, 'dBFS'
    return db + float(full_scale_dbm), 'dBm'


def _freq_unit(freq):
    """Hz drawn in MHz or kHz, whichever leaves the axis readable."""
    hi = float(np.max(np.abs(freq))) if freq.size else 0.0
    if hi >= 1e6:
        return freq / 1e6, 'MHz'
    if hi >= 1e3:
        return freq / 1e3, 'kHz'
    return freq, 'Hz'


def cell_boxes(lte, nr, t_lo, t_hi, offset_s=0.0):
    """Boxes over the cells' sync signals between ``t_lo`` and ``t_hi`` seconds.

    ``lte`` and ``nr`` are the card's sections (``iqmeasure.cells_file``); their times
    count from ``offset_s`` seconds into the file. Each box is a dict: ``kind`` ('lte' or
    'nr'), ``pci``, ``label``, ``t0``, ``t1`` (seconds into the file), ``f_lo``, ``f_hi``
    (absolute Hz). An LTE frame offset is known modulo 5 ms here (both half-frames carry
    the PSS and SSS), so its boxes repeat every 5 ms; an NR cell's repeat every burst
    period (20 ms when it was not measured).
    """
    boxes = []
    if isinstance(lte, dict) and lte.get('verdict') == 'lte':
        block = float(lte['block_center_hz'])
        for cell in lte.get('cells') or []:
            if cell.get('frame_offset_s') is None:
                continue
            times = LTE_SYNC_TIMES.get(cell.get('duplex') or 'FDD', LTE_SYNC_TIMES['FDD'])
            base = offset_s + float(cell['frame_offset_s']) % LTE_HALF_FRAME_S
            k = math.floor((t_lo - base) / LTE_HALF_FRAME_S) - 1
            while base + k * LTE_HALF_FRAME_S <= t_hi:
                start = base + k * LTE_HALF_FRAME_S
                for a, b in times:
                    if start + b * LTE_TS > t_lo and start + a * LTE_TS < t_hi:
                        boxes.append({'kind': 'lte', 'pci': cell['pci'], 'label': f"LTE PCI {cell['pci']}",
                                      't0': start + a * LTE_TS, 't1': start + b * LTE_TS,
                                      'f_lo': block - LTE_SYNC_HALF_HZ, 'f_hi': block + LTE_SYNC_HALF_HZ})
                k += 1
    if isinstance(nr, dict):
        for e in nr.get('ssbs') or []:
            if e.get('first_ssb_s') is None:
                continue
            scs = float(e['scs_khz']) * 1e3
            length = 4 * NR_SSB_SYMBOL_TS / (2048 * scs)
            period = (e.get('period_ms') or 20) * 1e-3
            first = offset_s + float(e['first_ssb_s'])
            k = math.floor((t_lo - first) / period) - 1
            while first + k * period <= t_hi:
                start = first + k * period
                if start + length > t_lo and start < t_hi:
                    boxes.append({'kind': 'nr', 'pci': e['pci'], 'label': f"NR PCI {e['pci']}",
                                  't0': start, 't1': start + length,
                                  'f_lo': float(e['ssb_hz']) - 120 * scs,
                                  'f_hi': float(e['ssb_hz']) + 120 * scs})
                k += 1
    return boxes


def peak_panel(path, t0=None, t1=None, band=None, rate=None, center_hz=None, nfft=None):
    """Absolute frequency axis and the peak-hold level the top panel plots.

    Both are 1-d numpy arrays. ``band`` is ``(lo_hz, hi_hz)`` in absolute Hz;
    only the bins inside it are returned. Raises ``iqmeasure.IQSourceError``
    when the file cannot be read.
    """
    src = _open(path, rate, center_hz)
    i0, i1 = _indexes(src, t0, t1)
    freq, _mean, peak, _wf = spectra(src, i0, i1, nfft, band)
    peak_db, _unit = _db(peak, src.full_scale_dbm)
    return np.asarray(freq, dtype=np.float64), np.asarray(peak_db, dtype=np.float64)


def render(path, out, t0=None, t1=None, band=None, rate=None, center_hz=None, nfft=None,
           cells=False):
    """Write the PNG of ``path`` to ``out``. Nothing is written if reading fails.
    ``cells`` boxes the LTE and NR cells' sync signals (see the module docstring)."""
    src = _open(path, rate, center_hz)
    if cells:
        if t1 is None:
            t1 = min(src.seconds, (0.0 if t0 is None else _finite("--t0", t0)) + CELLS_SPAN_S)
        nfft = CELLS_NFFT if nfft is None else nfft
    i0, i1 = _indexes(src, t0, t1)
    found = None
    if cells:
        lte, nr = iqmeasure.cells_file(path, t0=i0 / src.rate, rate=rate, center_hz=center_hz)
        found = (lte, nr)
    freq, mean, peak, waterfall = spectra(src, i0, i1, nfft, band)
    mean_db, unit = _db(mean, src.full_scale_dbm)
    peak_db, _unit = _db(peak, src.full_scale_dbm)
    wf_db, _unit = _db(waterfall, src.full_scale_dbm)
    fx, funit = _freq_unit(freq)
    t_lo = i0 / src.rate
    # The last partial block is not a whole FFT, so the picture ends on the last block.
    length = _nfft_of(i1 - i0, nfft)
    t_hi = (i0 + length * ((i1 - i0) // length)) / src.rate

    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt

    fig, (top, wf) = plt.subplots(2, 1, figsize=(12, 8), sharex=True,
                                  gridspec_kw={'height_ratios': [1, 3]},
                                  constrained_layout=True)
    top.plot(fx, peak_db, lw=0.6, label='peak')
    top.plot(fx, mean_db, lw=0.6, label='mean')
    top.set_ylabel(unit)
    top.legend(loc='upper right')
    top.set_title(f"{os.path.basename(src.path)}: centre {src.center_hz / 1e6:.6g} MHz, "
                  f"rate {src.rate / 1e6:.6g} MS/s, span {t_lo:.6g}–{t_hi:.6g} s")
    img = wf.imshow(wf_db, aspect='auto', origin='lower', cmap='viridis',
                    extent=[fx[0], fx[-1], t_lo, t_hi],
                    vmin=float(wf_db.min()), vmax=float(wf_db.max()))
    fig.colorbar(img, ax=[top, wf], label=unit, pad=0.01)
    if found is not None:
        _draw_cells(wf, found, t_lo, t_hi, funit)
    wf.set_xlabel(funit)
    wf.set_ylabel('seconds')
    # The full level range is on the colour bar, and the layout keeps the labels.
    try:
        fig.savefig(out, dpi=110)
    except OSError as exc:
        plt.close(fig)
        try:
            os.remove(out)
        except OSError:
            pass
        _fail(f"could not write {out}: {exc}")
    plt.close(fig)


def _draw_cells(ax, found, t_lo, t_hi, funit):
    """The ``cell_boxes`` on the waterfall ``ax`` (frequency in ``funit``), and a note of them."""
    from matplotlib.patches import Rectangle
    scale = {'MHz': 1e6, 'kHz': 1e3}.get(funit, 1.0)
    lte, nr = found
    boxes = cell_boxes(lte, nr, t_lo, t_hi, offset_s=t_lo)
    colours = {'lte': 'white', 'nr': 'red'}
    # One label per place: synchronised cells share their boxes, so their PCIs share a label.
    places = {}
    for b in boxes:
        ax.add_patch(Rectangle((b['f_lo'] / scale, b['t0']), (b['f_hi'] - b['f_lo']) / scale,
                               b['t1'] - b['t0'], fill=False, lw=1.0, ec=colours[b['kind']]))
        if not any(b['pci'] in pcis for (kind, _t, _f), pcis in places.items() if kind == b['kind']):
            places.setdefault((b['kind'], round(b['t1'], 6), b['f_hi']), []).append(b['pci'])
    for (kind, t1, f_hi), pcis in places.items():
        ax.text(f_hi / scale, t1, f" {kind.upper()} PCI {', '.join(str(p) for p in pcis)}",
                color=colours[kind], fontsize=8, va='bottom', ha='left')
    names = sorted({b['label'] for b in boxes})
    why = [s.get('reason') for s in (lte, nr) if isinstance(s, dict) and not s.get('searched')]
    note = ', '.join(names) if names else 'no LTE or NR cell found in 50 ms' + (
        f" ({why[0]})" if why else '')
    ax.set_title(f"cells: {note}", fontsize=9)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('file', help="the IQ recording (.cfile, .sdvr or .cdif)")
    ap.add_argument('out', help="the PNG to write")
    ap.add_argument('--t0', type=float, metavar='S', help="start of the span, seconds")
    ap.add_argument('--t1', type=float, metavar='S', help="end of the span, seconds")
    ap.add_argument('--band', nargs=2, type=float, metavar=('LO', 'HI'),
                    help="absolute Hz to show (default: the whole rate)")
    ap.add_argument('--rate', type=float, metavar='R', help="sample rate, for a bare .cfile")
    ap.add_argument('--center', type=float, dest='center_hz', metavar='HZ',
                    help="centre frequency, Hz")
    ap.add_argument('--nfft', type=int, metavar='N',
                    help="FFT length (default 4096, or 256 with --cells; powers of two are fastest)")
    ap.add_argument('--cells', action='store_true',
                    help="box the LTE and NR cells' sync signals (default span 20 ms)")
    args = ap.parse_args(argv)
    try:
        render(args.file, args.out, t0=args.t0, t1=args.t1, band=args.band,
               rate=args.rate, center_hz=args.center_hz, nfft=args.nfft, cells=args.cells)
    except iqmeasure.IQSourceError as exc:
        print(exc, file=sys.stderr)
        return 1
    except (ValueError, OverflowError) as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
