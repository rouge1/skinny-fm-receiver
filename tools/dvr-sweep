#!/usr/bin/env python3
"""dvr-sweep: the spectrum a Sceptre DVR (.sdvr) holds, as a waterfall picture.

    tools/dvr-sweep DVR.sdvr                       what it holds (no picture)
    tools/dvr-sweep DVR.sdvr --png out.png         the whole span, all of it
    tools/dvr-sweep DVR.sdvr --band 88 108 --png fm.png

Reads the DVR's spectrum tiles: a sweep DVR's (9 kHz to 6 GHz in 4.88 kHz
bins), or an IQ DVR's, over its band. The DVR may still be recording: the
newest tile is left out and a tile Sceptre overwrites while it is read is
dropped, and the report says so. Levels are dBm, each tile by the gain and
offset its own header carries (``--bytes`` draws the raw signed bytes, whose
scale changes from tile to tile and shows as bands across the waterfall).
Needs numpy; matplotlib for ``--png``. The DVR is only read.
"""

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from fm_receiver import sceptre_dvr  # noqa: E402


def clock(t):
    return time.strftime('%H:%M:%S', time.localtime(t))


def picture(path, sw, times, freqs, db, out, unit):
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    import numpy as np
    cols = 1600                      # a wide band is drawn as the peak of each slice
    if db.shape[1] > cols:
        edges = np.linspace(0, db.shape[1], cols + 1).astype(int)
        db = np.maximum.reduceat(db, edges[:-1], axis=1)
        freqs = freqs[edges[:-1]]
    fig, (top, wf) = plt.subplots(2, 1, figsize=(12, 8), sharex=True,
                                  gridspec_kw={'height_ratios': [1, 3]})
    mhz = freqs / 1e6
    top.plot(mhz, db.max(0), lw=0.6, label='peak')
    top.plot(mhz, db.mean(0), lw=0.6, label='mean')
    top.set_ylabel(unit)
    top.legend(loc='upper right')
    top.set_title(f"{os.path.basename(path)}: {len(times)} sweeps over "
                  f"{times[-1] - times[0]:.0f} s from {clock(times[0])}")
    lo, hi = np.percentile(db, [1, 99.8])
    img = wf.imshow(db, aspect='auto', origin='lower', cmap='viridis', vmin=lo,
                    vmax=hi, extent=[mhz[0], mhz[-1], 0, times[-1] - times[0]])
    fig.colorbar(img, ax=[top, wf], label=unit, pad=0.01)
    wf.set_xlabel('MHz')
    wf.set_ylabel('seconds')
    fig.savefig(out, dpi=110)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('dvr', help="the Sceptre DVR file (.sdvr)")
    ap.add_argument('--band', nargs=2, type=float, metavar=('LO', 'HI'),
                    help="MHz to show (default: all of it)")
    ap.add_argument('--png', metavar='FILE', help="write a waterfall picture")
    ap.add_argument('--bytes', action='store_true',
                    help="the raw signed bytes, not dBm (each tile has its own scale)")
    args = ap.parse_args(argv)
    try:
        sw = sceptre_dvr.Sweeps(args.dvr)
        lo, hi = ((args.band[0] * 1e6, args.band[1] * 1e6) if args.band
                  else (None, None))
        lay = sw.layout
        print(f"{os.path.basename(args.dvr)}: {len(sw.tiles)} tiles of {sw.sweeps} "
              f"sweeps, {sw.bins} bins of {sw.bin_hz:.2f} Hz from "
              f"{sw.start_hz / 1e6:.4f} MHz; {clock(lay['start'])} to "
              f"{clock(lay['end'])} ({lay['end'] - lay['start']:.0f} s, "
              f"{lay['gaps']} gaps)"
              + ("; being written now (its newest tile left out)" if lay['live']
                 else ""))
        if not args.png:
            return
        times, freqs, db = sw.read(lo, hi, dbm=not args.bytes)
    except (sceptre_dvr.SdvrError, OSError) as exc:
        sys.exit(f"dvr-sweep: {exc}")
    if sw.overwritten:
        print(f"{sw.overwritten} tiles were overwritten while reading; "
              "they are not in the picture")
    if not len(times):
        sys.exit("dvr-sweep: no tile could be read")
    picture(args.dvr, sw, times, freqs, db, args.png,
            'DVR byte' if args.bytes else 'dBm')
    print(f"wrote {args.png} ({db.shape[0]} sweeps x {db.shape[1]} bins)")


if __name__ == '__main__':
    main()
