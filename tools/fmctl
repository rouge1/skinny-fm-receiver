#!/usr/bin/env python3
"""fmctl: work the running FM receiver window from the command line.

    tools/fmctl status
    tools/fmctl tune 99.1
    tools/fmctl 'tune 99.1; wait 3; status'     several, in turn
    tools/fmctl help                             every command
    tools/fmctl open "my folder/a b.cfile"       a path with a space
    tools/fmctl 'capture 6; cells nr decode'     the 5G NR cells in a capture

Each command goes to the window's control socket (fm_receiver/control.py)
and its reply is printed as JSON. A path (open, recordings-folder, folders
add/remove, screenshot, cells) is made absolute here: the window has its own working
folder. Exits 1 if any command failed, 2 if no window is listening. Plain
Python: no Qt, no conda environment needed.
"""

import json
import os
import shlex
import socket
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from fm_receiver.config import control_path  # noqa: E402


def absolute(name, args):
    """The arguments, with the path made absolute here: the window has its own cwd."""
    def here(path):
        return os.path.abspath(os.path.expanduser(path)) if path.strip() else path
    if name == 'folders':
        if len(args) == 2 and args[0].lower() in ('add', 'remove'):
            return [args[0], here(args[1])]
    elif name in ('open', 'screenshot', 'recordings-folder') and len(args) == 1:
        return [here(args[0])]
    elif name == 'cells' and len(args) >= 2 and args[-1].lower() not in ('lte', 'nr', 'decode'):
        return [*args[:-1], here(args[-1])]
    return args


def segments(script):
    """The ';'-separated commands of a script. A ';' inside quotes, or escaped
    with a backslash, stays in its command."""
    parts, cur, quote, escaped = [], '', None, False
    for ch in script:
        if escaped:
            escaped = False
        elif ch == '\\' and quote != "'":
            escaped = True
        elif quote:
            quote = None if ch == quote else quote
        elif ch in ('"', "'"):
            quote = ch
        elif ch == ';':
            parts.append(cur)
            cur = ''
            continue
        cur += ch
    return parts + [cur]


def commands(argv):
    """The words of each command. One argument is a script, as the help shows
    ('tune 99.1; status'). Several are one command as the shell split it
    ('open', 'a b.cfile'): quoted again, so a path with a space stays whole."""
    script = argv[0] if len(argv) == 1 else ' '.join(
        ';' if word == ';' else shlex.quote(word) for word in argv)
    return [words for words in (shlex.split(part) for part in segments(script)) if words]


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip())
        return 0
    try:
        requests = [[words[0], *absolute(words[0].lower(), words[1:])]
                    for words in commands(argv)]
    except ValueError as exc:
        print(f"fmctl: bad quoting: {exc}", file=sys.stderr)
        return 1
    path = control_path()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
    except OSError as exc:
        print(f"fmctl: no FM receiver window listening on {path} ({exc})", file=sys.stderr)
        return 2
    failed = False
    with sock, sock.makefile('rwb') as stream:
        for words in requests:
            # JSON, so the words reach the window as they are: no quoting to undo.
            line = json.dumps({'cmd': words[0].lower(), 'args': words[1:]})
            stream.write(line.encode() + b'\n')
            stream.flush()
            answer = stream.readline()
            if not answer:
                print("fmctl: the window closed the connection", file=sys.stderr)
                return 2
            reply = json.loads(answer)
            if len(requests) > 1:
                reply = {'command': shlex.join(words), **reply}
            print(json.dumps(reply, indent=2))
            failed |= not reply.get('ok')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
